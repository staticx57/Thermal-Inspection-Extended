# Auto detect text files and perform LF normalization
* text=auto

# Scripts must keep the line endings their interpreter needs, whatever core.autocrlf says on the machine:
# cmd.exe mis-parses labels/goto in LF-only .bat files; bash fails on a trailing \r in CRLF .sh files.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
